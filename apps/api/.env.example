# Server
NODE_ENV=development
PORT=3000

# MongoDB (cloud)
MONGODB_URL=mongodb://localhost:27017/lexiscene?replicaSet=rs0
# Redis (cloud)
REDIS_URL=localhost

# Auth (Phase 1)
JWT_ACCESS_SECRET=<generate-with-openssl-rand-base64-64>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<generate-with-openssl-rand-base64-64>
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (Phase 1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Email (Phase 1)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
